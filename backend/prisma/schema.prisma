generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// COMPANIES
// ==========================================
model Company {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  website     String?
  location    String?
  logoUrl     String?
  ownerId     String   @unique // References MongoDB User._id (ObjectId, not UUID) — one company per recruiter
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@map("companies")
}

// ==========================================
// JOBS
// ==========================================
model Job {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  description     String
  location        String
  jobType         String // full-time | part-time | internship | contract | freelance (CHECK constraint)
  experienceLevel String // entry | junior | mid | senior | lead (CHECK constraint)
  requirements    String[]
  salaryType      String // fixed | range | negotiable (CHECK constraint)
  salary          Json? // { min?, max?, currency? }
  isOpen          Boolean  @default(true)
  companyId       String   @db.Uuid
  recruiterId     String // References MongoDB User._id (ObjectId, not UUID)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedBy      SavedJob[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([isOpen, createdAt])
  @@map("jobs")
}

// ==========================================
// APPLICATIONS
// ==========================================
model Application {
  id              String            @id @default(uuid()) @db.Uuid
  jobId           String            @db.Uuid
  applicantId     String // References MongoDB User._id (ObjectId, not UUID)
  experienceYears Int // >= 0 (CHECK constraint)
  experienceLevel String // entry | junior | mid | senior | lead (CHECK constraint)
  status          ApplicationStatus @default(PENDING)
  withdrawnAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([status])
  @@index([expiresAt])
  @@map("applications")
}

// ==========================================
// SAVED JOBS
// ==========================================
model SavedJob {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  userId    String // References MongoDB User._id (ObjectId, not UUID)
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@map("saved_jobs")
}

// ==========================================
// ENUMS
// ==========================================
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}
