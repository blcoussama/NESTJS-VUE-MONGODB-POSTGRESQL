# PROFYLE v2 : variables pour `docker compose` (copier vers `.env`, jamais commite).
#   cp .env.example .env
# Ce fichier ne contient AUCUN secret reel. Generer les secrets avec :
#   openssl rand -hex 32
# Utiliser des mots de passe alphanumeriques/hex (ils sont places dans des URL de connexion).

# --- Bases de donnees (obligatoires : mots de passe) -------------------------
MONGO_ROOT_USER=profyle
MONGO_ROOT_PASSWORD=
MONGO_DB=profyle
POSTGRES_USER=profyle
POSTGRES_PASSWORD=
POSTGRES_DB=profyle

# --- JWT (>= 32 caracteres, differents l'un de l'autre) ----------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- AWS S3 (obligatoires au demarrage ; valeurs factices OK si vous n'utilisez
#     pas l'upload d'avatar / logo / CV, sinon cle IAM a moindre privilege) -----
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# --- Email SMTP (obligatoires au demarrage ; factices OK hors verification
#     d'email / reset de mot de passe) ----------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@example.com

# --- Reseau / ports publies (tous lies a 127.0.0.1 par defaut) ---------------
CLIENT_URL=http://localhost:8080
FRONTEND_PORT=8080
# FRONTEND_BIND=127.0.0.1   # mettre 0.0.0.0 pour exposer le frontend au reseau
BACKEND_PORT=3000
MONGO_PORT=27017
POSTGRES_PORT=5432

# --- Frontend (build) : URL de l'API vue par le navigateur -------------------
# "/api" = meme origine, relaye par nginx (recommande).
VITE_API_URL=/api
